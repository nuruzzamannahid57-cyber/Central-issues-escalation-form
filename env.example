# Turso database connection (Settings > your DB > "Connect" in the Turso dashboard,
# or `turso db show <name>` / `turso db tokens create <name>` on the CLI)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# A password of your choosing — required in the x-setup-key header to create
# new logins via POST /api/auth/register. Keep this private; anyone who has
# it can create a login. Change it to your own value.
SETUP_KEY=change-me-to-something-only-you-know

PORT=3000

# ---- Daily pending-issues email report ----
# SMTP credentials to send mail from. Works with Gmail (use an App Password,
# not your normal password), Zoho Mail, Outlook, SendGrid's SMTP relay, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sending-account@carrybee.com
SMTP_PASS=your-smtp-password-or-app-password
MAIL_FROM="Carrybee Ops Console <your-sending-account@carrybee.com>"

# Cron expression + timezone for the daily send. Default: 11:59 PM, Asia/Dhaka.
DAILY_REPORT_CRON=59 23 * * *
DAILY_REPORT_TZ=Asia/Dhaka
# Set to "false" to disable the scheduled send without removing the code.
DAILY_REPORT_ENABLED=true
